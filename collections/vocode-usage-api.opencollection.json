{
  "opencollection": "1.0.0",
  "info": {
    "name": "Vocode Hosted Actions Usage API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Usage",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get account usage",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.vocode.dev/v1/usage"
          },
          "docs": "Returns the account plan type and monthly call-minute usage against any limit."
        }
      ]
    }
  ],
  "bundled": true
}